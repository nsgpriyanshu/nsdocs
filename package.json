{
  "name": "nsdocs",
  "version": "2.1.0",
  "description": "A centralized documentation hub for all the open-source projects built and maintained by nsgpriyanshu",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "format:check": "npx prettier . --check",
    "format:write": "npx prettier . --write",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint",
    "release": "cliff-jumper"
  },
  "keywords": [
    "nsCore",
    "nsDocs",
    "discord"
  ],
  "author": "nsgpriyanshu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nsgpriyanshu/nsdocs",
    "homepage": "https://github.com/nsgpriyanshu/nsdocs#readme",
    "bugs": {
      "url": "https://github.com/nsgpriyanshu/nsdocs/issues"
    }
  },
  "dependencies": {
    "fumadocs-core": "16.2.5",
    "fumadocs-mdx": "14.1.1",
    "fumadocs-ui": "16.2.5",
    "lucide-react": "^0.556.0",
    "next": "16.2.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "scroll-into-view-if-needed": "^3.1.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@favware/cliff-jumper": "^6.0.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.0.10",
    "postcss": "^8.5.6",
    "prettier": "3.7.4",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3"
  }
}
